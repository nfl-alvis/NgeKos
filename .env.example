# ==============================================================================
# NGEKOST ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# Salin berkas ini menjadi `.env.local` dan lengkapi nilai variabel di bawah ini.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE & SUPABASE
# ------------------------------------------------------------------------------
# Connection string ke database PostgreSQL (via Supabase pooler / direct)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Supabase API & Auth
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
SUPABASE_SECRET_KEY="your-supabase-secret-service-role-key"

# Storage Bucket untuk foto properti
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET="property-images"

# ------------------------------------------------------------------------------
# 2. APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Geocoding API (Geoapify) untuk pencarian lokasi koordinat kos
GEOAPIFY_API_KEY="your-geoapify-api-key"

# ------------------------------------------------------------------------------
# 3. MIDTRANS PAYMENT GATEWAY
# Dapatkan Server Key & Client Key dari:
# - Sandbox: https://dashboard.sandbox.midtrans.com/settings/access-keys
# - Production: https://dashboard.midtrans.com/settings/access-keys
# ------------------------------------------------------------------------------
# Server Key (Rahasia - hanya digunakan di backend/server)
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxxxxxxxxxxxxxx"

# Client Key (Publik - digunakan oleh frontend Snap popup)
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxxxxxxxxxxxxxx"

# Mode Midtrans: 'false' untuk Sandbox (Testing), 'true' untuk Production
MIDTRANS_IS_PRODUCTION="false"
NEXT_PUBLIC_MIDTRANS_IS_PRODUCTION="false"

# URL Merchant Notification Webhook Midtrans yang didaftarkan di dashboard Midtrans:
# Format: https://yourdomain.com/api/payments/midtrans/webhook
